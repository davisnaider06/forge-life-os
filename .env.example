# Sem estas variáveis, o FORGE funciona localmente, sem login obrigatório.
NEXT_PUBLIC_APP_URL=http://localhost:4180
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOMENTE servidor. Nunca use prefixo NEXT_PUBLIC nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
CRON_SECRET=
# Agente do FORGE (usa a sua assinatura do Claude, nunca chave de API).
# E-mails liberados para usar o chat, separados por vírgula.
FORGE_AGENT_EMAILS=
# Local: vazio, o agente roda aqui com o login do Claude Code desta máquina.
# Vercel: URL do serviço em agent-server/ e o mesmo segredo configurado lá (32+ caracteres).
FORGE_AGENT_URL=
FORGE_AGENT_SECRET=
# Só no serviço do agente: gere com "claude setup-token".
CLAUDE_CODE_OAUTH_TOKEN=
